{
  "compilerOptions": {
    "module": "preserve",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "stripInternal": true
  },
  "include": ["src"]
}
