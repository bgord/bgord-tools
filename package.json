{
  "name": "@bgord/tools",
  "version": "1.5.14",
  "type": "module",
  "license": "MIT",
  "author": "Bartosz Gordon",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bash scripts/package-build.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@types/bun": "1.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260614.1",
    "cspell": "10.0.1",
    "fallow": "2.96.0",
    "lefthook": "2.1.9",
    "lockfile-lint": "5.0.0",
    "publint": "0.3.21",
    "shellcheck": "4.1.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "temporal-polyfill": "0.3.2",
    "valibot": "1.4.1"
  },
  "sideEffects": false,
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "error"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  }
